# e-Kisan Procurement (ई-किसान सेतु) - Environment Variables
# Copy these to .env and insert your real Supabase Project credentials

# 1. Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon Public API Key (from Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# 3. Environment Mode ('development' | 'production')
VITE_APP_ENV=development
